# ============================================================================
# 多服务器部署清单 —— 复制为 deploy/servers.local.env 后填入真实值
#   cp deploy/servers.local.env.example deploy/servers.local.env
#
# ⚠️ servers.local.env 已被 .gitignore 忽略；真实的服务器 IP / 密钥路径
#    只写在本地那份里，绝不入库（避免服务器信息泄露到 GitHub）。
# ============================================================================

# 要部署的服务器列表，每行一台，格式： user@host|SSH私钥路径(留空=默认 ~/.ssh/id_rsa)
DEPLOY_SERVERS=(
  # 示例1：密钥已授权到默认 ~/.ssh/id_rsa 的服务器，第二段留空
  "root@<服务器1_IP>|"
  # 示例2：用独立 .pem 密钥的服务器（路径用 git-bash 的 /c/... 格式）
  "root@<服务器2_IP>|/c/Users/你/路径/xxx.pem"
)

# 部署的镜像
IMAGE="ghcr.io/tseng-xp/sub2api:latest"

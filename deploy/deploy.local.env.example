# ============================================================================
# 本地部署凭据模板 —— 复制为 deploy.local.env 后填入真实值
#   cp deploy/deploy.local.env.example deploy/deploy.local.env
#
# ⚠️ deploy.local.env 已被 .gitignore 忽略，绝不会进入 git / 推到 GitHub。
#    真实的服务器 IP、root 密码只放在这个本地文件里。
# ============================================================================

# 服务器 IP（例：47.106.x.x）
export SERVER_HOST=""

# 服务器 root 密码（仅当用密码登录时需要；已配 SSH 密钥可留空）
export SERVER_PASSWORD=""

# 你的 fork 镜像（GitHub Actions 构建后推到这里）
export IMAGE="ghcr.io/tseng-xp/sub2api:latest"

# 服务器上 compose 目录
export REMOTE_DEPLOY_DIR="/root/sub2api/deploy"

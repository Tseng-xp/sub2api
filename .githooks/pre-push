#!/bin/sh
set -eu

remote_name="${1:-}"
if command -v python >/dev/null 2>&1; then
  exec python tools/check_secrets.py --pre-push --remote "$remote_name"
fi
if command -v py >/dev/null 2>&1; then
  exec py -3 tools/check_secrets.py --pre-push --remote "$remote_name"
fi

echo "Blocked: Python is required to scan commits before pushing." >&2
exit 1
